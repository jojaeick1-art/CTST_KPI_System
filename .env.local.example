# 로컬 개발·빌드용 — 이 파일을 복사해 .env.local 로 저장하세요.
# Supabase 대시보드 → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_CAPA_RECIPE_BUCKET=capa-recipes
NEXT_PUBLIC_CAPA_RECIPE_LEGACY_BUCKET=kpi-evidence

# (선택) 엑셀·스크립트·계정 관리 API 등 서버 작업용
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# (선택) 통합 Hub 읽기 전용 API(/api/v1/integrations/kpi/*) 인증용.
# 충분히 긴 무작위 문자열로 직접 생성해 서버 환경변수로만 등록하세요.
# NEXT_PUBLIC_ 접두어를 붙이지 마세요 — 붙이면 브라우저에 노출됩니다.
# HUB_API_TOKEN=your_hub_api_token_here
